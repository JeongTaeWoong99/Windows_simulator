---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { STATUS_STYLE, OWNER_STYLE, PRIORITY_STYLE } from '../../lib/labels';

export async function getStaticPaths() {
  const tasks = await getCollection('tasks');
  return tasks.map((t) => ({ params: { slug: t.data.slug }, props: { task: t.data } }));
}

const { task } = Astro.props;
---

<Layout title={`${task.taskId} ${task.title}`}>
  <a href="/tasks" class="text-xs text-slate-400 hover:text-blue-600">← 일감 목록</a>

  <header class="mt-3 mb-6 pb-5 border-b border-slate-200">
    <div class="font-mono text-xs text-slate-400 mb-1">{task.taskId}</div>
    <h1 class="text-2xl font-extrabold mb-3">{task.title}</h1>
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <span class={`px-2 py-0.5 rounded-full ${OWNER_STYLE[task.owner] ?? ''}`}>{task.owner}</span>
      <span class={`px-2 py-0.5 rounded-full ${STATUS_STYLE[task.status]?.cls ?? ''}`}>{task.status}</span>
      <span class={PRIORITY_STYLE[task.priority] ?? ''}>우선순위 {task.priority}</span>
      <span class="text-slate-400">마감 {task.due}</span>
      {task.done && <span class="text-slate-400">· 보관됨</span>}
    </div>
  </header>

  <article class="doc" set:html={task.bodyHtml} />
</Layout>
