---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { STATUS_STYLE, OWNER_STYLE, PRIORITY_STYLE, PRIORITY_ORDER, STATUS_ORDER } from '../../lib/labels';

const all = await getCollection('tasks');

// INDEX와 같은 기준 — 상태(진행중 > 보류 > 대기) 다음 우선순위.
const byRank = (a: any, b: any) =>
  (STATUS_ORDER[a.data.status] ?? 9) - (STATUS_ORDER[b.data.status] ?? 9) ||
  (PRIORITY_ORDER[a.data.priority] ?? 9) - (PRIORITY_ORDER[b.data.priority] ?? 9) ||
  a.data.taskId.localeCompare(b.data.taskId);

const byId = (a: any, b: any) => a.data.taskId.localeCompare(b.data.taskId);

// 열 보드는 INDEX(tasks/ 루트)만. art/·later/는 남은 일이지만 목록과 섞지 않고 아래 접힌 칸에 둔다.
const open = all.filter((t) => t.data.bucket === 'open').sort(byRank);
const art = all.filter((t) => t.data.bucket === 'art').sort(byId);
const later = all.filter((t) => t.data.bucket === 'later').sort(byId);
const done = all.filter((t) => t.data.done).sort(byId);

const shelves = [
  { key: 'art', label: '🎨 아트만 남음', note: '기능은 섰고 연출·리소스만 남았다 — 메인이 다 선 뒤 한꺼번에', items: art },
  { key: 'later', label: '⏳ 나중에', note: '먼 훗날(배포 전 게이트 등) 할 것', items: later },
];

// 담당이 곧 열이다. 공용은 어느 열에도 속하지 않아 위에 따로 둔다.
const shared = open.filter((t) => t.data.owner === '공용');
const client = open.filter((t) => t.data.owner === '클라');
const server = open.filter((t) => t.data.owner === '서버');

const columns = [
  { owner: '클라', items: client, accent: 'violet' },
  { owner: '서버', items: server, accent: 'sky' },
];
---

<Layout title="일감">
  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
    <h1 class="text-xl font-extrabold">일감</h1>
    <p class="text-sm text-slate-500">
      남은 일 {open.length}건 — 클라 {client.length} · 서버 {server.length} · 공용 {shared.length}
    </p>
  </div>
  <p class="text-xs text-slate-400 mb-5">
    담당이 곧 열이다. <strong class="text-slate-500">공용</strong>은 어느 한쪽 폴더로 갈리지 않아 위에 둔다 —
    대개 <em>기획 결정</em>이라 양쪽을 함께 막는다.
  </p>

  <!-- 태그 필터 — 열을 지우지 않고 항목만 걸러낸다 -->
  <div class="flex flex-wrap gap-1.5 mb-6" id="owner-filter">
    <button class="tagbtn" data-filter="전체" data-on="true">전체</button>
    <button class="tagbtn" data-filter="클라">클라 {client.length}</button>
    <button class="tagbtn" data-filter="서버">서버 {server.length}</button>
    <button class="tagbtn" data-filter="공용">공용 {shared.length}</button>
  </div>

  {
    shared.length > 0 && (
      <section class="mb-8" data-owner="공용">
        <h2 class="flex items-center gap-2 text-sm font-bold text-slate-500 mb-3">
          <span class={`text-[11px] px-2 py-0.5 rounded-full ${OWNER_STYLE['공용']}`}>공용</span>
          클라·서버가 함께 보는 것
        </h2>
        <ul class="grid gap-2 sm:grid-cols-2">
          {shared.map((t) => (
            <li data-owner="공용">
              <a href={`/tasks/${t.data.slug}`} class="taskcard">
                <div class="flex items-center gap-2 mb-1">
                  <span class="font-mono text-[11px] text-slate-400">{t.data.taskId}</span>
                  <span class={`text-[10px] px-1.5 py-0.5 rounded-full ${STATUS_STYLE[t.data.status]?.cls ?? ''}`}>
                    {t.data.status}
                  </span>
                  <span class={`ml-auto text-[11px] ${PRIORITY_STYLE[t.data.priority] ?? ''}`}>
                    {t.data.priority}
                  </span>
                </div>
                <div class="text-sm font-semibold leading-snug">{t.data.title}</div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="grid gap-5 md:grid-cols-2">
    {
      columns.map((col) => (
        <section data-owner={col.owner}>
          <h2 class="flex items-center gap-2 text-sm font-bold text-slate-500 mb-3 pb-2 border-b border-slate-200">
            <span class={`text-[11px] px-2 py-0.5 rounded-full ${OWNER_STYLE[col.owner]}`}>{col.owner}</span>
            <span class="text-slate-400 font-normal">{col.items.length}건</span>
          </h2>
          <ul class="space-y-2">
            {col.items.map((t) => (
              <li data-owner={col.owner}>
                <a href={`/tasks/${t.data.slug}`} class="taskcard">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="font-mono text-[11px] text-slate-400">{t.data.taskId}</span>
                    <span class={`text-[10px] px-1.5 py-0.5 rounded-full ${STATUS_STYLE[t.data.status]?.cls ?? ''}`}>
                      {t.data.status}
                    </span>
                    <span class={`ml-auto text-[11px] ${PRIORITY_STYLE[t.data.priority] ?? ''}`}>
                      {t.data.priority}
                    </span>
                  </div>
                  <div class="text-sm font-semibold leading-snug">{t.data.title}</div>
                </a>
              </li>
            ))}
            {col.items.length === 0 && (
              <li class="text-xs text-slate-400 border border-dashed border-slate-200 rounded-lg px-3 py-4 text-center">
                남은 일감이 없다
              </li>
            )}
          </ul>
        </section>
      ))
    }
  </div>

  <!-- INDEX 밖의 남은 일 — 기본은 접어 둔다. 필터(data-owner)는 걸지 않는다: 열 보드만 거른다 -->
  {
    shelves.map((s) => (
      <details class="mt-10 group">
        <summary class="cursor-pointer select-none text-sm font-bold text-slate-500">
          {s.label} {s.items.length}건
          <span class="font-normal text-xs text-slate-400 ml-1">— {s.note}</span>
        </summary>
        {s.items.length > 0 ? (
          <ul class="flex flex-wrap gap-2 mt-3">
            {s.items.map((t) => (
              <li>
                <a
                  href={`/tasks/${t.data.slug}`}
                  class="inline-flex items-center gap-2 bg-white border border-slate-200 rounded-full px-3 py-1 text-xs text-slate-600"
                >
                  <span class="font-mono text-slate-400">{t.data.taskId}</span>
                  <span class={`text-[10px] px-1.5 rounded-full ${OWNER_STYLE[t.data.owner] ?? ''}`}>{t.data.owner}</span>
                  {t.data.title}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-xs text-slate-400 mt-3">없다</p>
        )}
      </details>
    ))
  }

  <h2 class="text-sm font-bold text-slate-500 mt-10 mb-3">보관 — 끝난 일감 {done.length}건</h2>
  <ul class="flex flex-wrap gap-2">
    {
      done.map((t) => (
        <li>
          <a
            href={`/tasks/${t.data.slug}`}
            class="inline-flex items-center gap-2 bg-white border border-slate-200 rounded-full px-3 py-1 text-xs text-slate-500"
          >
            <span class="font-mono text-slate-400">{t.data.taskId}</span>
            {t.data.title}
          </a>
        </li>
      ))
    }
  </ul>

  <script>
    // 필터는 표시만 끈다 — 열 구조는 그대로 두어 "어느 쪽이 비었는지"가 계속 보이게 한다.
    const bar = document.getElementById('owner-filter');
    bar?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn) return;

      const pick = btn.dataset.filter ?? '전체';
      bar.querySelectorAll('button').forEach((b) => {
        b.dataset.on = String(b === btn);
      });

      document.querySelectorAll<HTMLElement>('[data-owner]').forEach((el) => {
        el.hidden = pick !== '전체' && el.dataset.owner !== pick;
      });
    });
  </script>
</Layout>
