---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import {
  STATUSES,
  STATUS_STYLE,
  PEOPLE,
  OWNER_STYLE,
  PRIORITY_STYLE,
  PRIORITY_ORDER,
  STATUS_ORDER,
  upcomingCycles,
} from '../../lib/labels';

const all = await getCollection('tasks');

// 상태 → 우선순위 → ID. 손이 가야 하는 것이 위로 온다.
const byRank = (a: any, b: any) =>
  (STATUS_ORDER[a.data.status] ?? 9) - (STATUS_ORDER[b.data.status] ?? 9) ||
  (PRIORITY_ORDER[a.data.priority] ?? 9) - (PRIORITY_ORDER[b.data.priority] ?? 9) ||
  a.data.taskId.localeCompare(b.data.taskId);

const live = all.filter((t) => !t.data.done).sort(byRank);
const closed = all.filter((t) => t.data.done).sort((a, b) => b.data.taskId.localeCompare(a.data.taskId));

// 회차 탭 — 다가오는 두 회차는 비어 있어도 띄우고, 일감에 적힌 다른 회차도 붙인다.
const isCycle = (v: string) => /^\d{6}$/.test(v);
const cycles = [...new Set([...upcomingCycles(2), ...live.map((t) => t.data.target).filter(isCycle)])].sort();

type Tab = { key: string; label: string; note: string; items: typeof all };
const tabs: Tab[] = [
  ...cycles.map((c) => ({
    key: c,
    label: `${c} 목표 일감`,
    note: `20${c.slice(0, 2)}-${c.slice(2, 4)}-${c.slice(4)} (토) 22:00 회의 — 그날 빌드에 들어갈 일`,
    items: live.filter((t) => t.data.target === c),
  })),
  {
    key: 'server',
    label: '서버·기획 일감',
    note: '담당 진우 — 회차와 상관없이 남은 전부',
    items: live.filter((t) => t.data.owner === '진우'),
  },
  {
    key: 'client',
    label: '클라 구현 일감',
    note: '담당 태웅 — 회차와 상관없이 남은 전부',
    items: live.filter((t) => t.data.owner === '태웅'),
  },
  {
    key: 'someday',
    label: '회차 밖',
    note: '목표 미정 — 🎨 아트만 남음 · ⏳ 나중에(배포 전 게이트 등)',
    items: live.filter((t) => !isCycle(t.data.target)),
  },
  { key: 'all', label: '남은 일감 전부', note: 'Closed를 뺀 전부', items: live },
  { key: 'closed', label: 'Closed', note: '끝났거나 취소된 일감', items: closed },
];

// 행 하나가 여러 탭에 속한다 — 탭마다 행을 복제하지 않고 data-tabs로 표시만 가른다.
const rows = [...live, ...closed].map((t, rank) => ({
  t,
  rank,
  sortId: Number(t.data.taskId.replace(/\D/g, '')) || 0,
  // 회차(YYMMDD)가 앞, 미정 등 글자는 뒤로 — '~'가 숫자보다 뒤에 온다.
  sortTarget: isCycle(t.data.target) ? t.data.target : `~${t.data.target}`,
  tabs: tabs.filter((tab) => tab.items.includes(t)).map((tab) => tab.key),
}));

// 표 머리를 누르면 이 값으로 정렬한다. 상태·우선순위는 글자가 아니라 정해 둔 순서로 잰다.
const COLUMNS = [
  { key: 'id', label: 'ID' },
  { key: 'title', label: '제목' },
  { key: 'owner', label: '담당' },
  { key: 'status', label: '상태' },
  { key: 'priority', label: '우선순위' },
  { key: 'target', label: '목표' },
];
---

<Layout title="일감">
  <div class="flex flex-col lg:flex-row gap-6">
    <!-- 왼쪽 탭 — 좁은 화면에서는 위로 올라가 가로로 넘긴다 -->
    <aside class="lg:w-52 shrink-0">
      <nav
        id="task-tabs"
        class="flex lg:flex-col gap-1 overflow-x-auto lg:overflow-visible lg:sticky lg:top-20 -mx-4 px-4 lg:mx-0 lg:px-0 pb-1"
        aria-label="일감 탭"
      >
        {
          tabs.map((tab) => (
            <button class="tasktab" data-tab={tab.key}>
              <span class="truncate">{tab.label}</span>
              <span class="ml-auto pl-2 text-[11px] font-normal text-slate-400">{tab.items.length}</span>
            </button>
          ))
        }
      </nav>
    </aside>

    <section class="flex-1 min-w-0">
      {
        tabs.map((tab) => (
          <header data-tab-head={tab.key} hidden>
            <h1 class="text-xl font-extrabold">{tab.label}</h1>
            <p class="text-xs text-slate-400 mt-1">{tab.note}</p>
          </header>
        ))
      }

      <!-- 담당·상태 필터 — 탭과 AND로 걸린다 -->
      <div class="flex flex-wrap items-center gap-1.5 mt-4 mb-2" id="owner-filter">
        <span class="text-xs font-bold text-slate-500 w-10">담당</span>
        <button class="tagbtn" data-filter="*" data-on="true">전체</button>
        {PEOPLE.map((p) => <button class="tagbtn" data-filter={p.name}>{p.name}<span class="font-normal text-slate-400 ml-1">{p.role}</span></button>)}
      </div>
      <div class="flex flex-wrap items-center gap-1.5 mb-4" id="status-filter">
        <span class="text-xs font-bold text-slate-500 w-10">상태</span>
        <button class="tagbtn" data-filter="*" data-on="true">전체</button>
        {STATUSES.map((s) => <button class="tagbtn" data-filter={s}>{s}</button>)}
      </div>

      <div class="overflow-x-auto bg-white border border-slate-200 rounded-lg">
        <table class="tasktable">
          <thead>
            <tr>
              {
                COLUMNS.map((c) => (
                  <th>
                    <button class="sorthead" data-sort={c.key} title="눌러서 정렬 — 오름차순 · 내림차순 · 기본 순서">
                      {c.label}
                      <span class="sortmark" aria-hidden="true" />
                    </button>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody id="task-rows">
            {
              rows.map(({ t, rank, sortId, sortTarget, tabs }) => (
                <tr
                  data-tabs={tabs.join(' ')}
                  data-owner={t.data.owner}
                  data-status={t.data.status}
                  data-rank={rank}
                  data-sort-id={sortId}
                  data-sort-title={t.data.title}
                  data-sort-owner={t.data.owner}
                  data-sort-status={STATUS_ORDER[t.data.status] ?? 9}
                  data-sort-priority={PRIORITY_ORDER[t.data.priority] ?? 9}
                  data-sort-target={sortTarget}
                  hidden
                >
                  <td class="font-mono text-[11px] text-slate-400 whitespace-nowrap">{t.data.taskId}</td>
                  <td>
                    <a href={`/tasks/${t.data.slug}`} class="font-semibold hover:text-blue-600">
                      {t.data.title}
                    </a>
                    {t.data.bucket === 'art' && <span class="ml-1 text-[11px] text-slate-400">🎨 아트만</span>}
                    {t.data.bucket === 'later' && <span class="ml-1 text-[11px] text-slate-400">⏳ 나중에</span>}
                    {t.data.closure && <span class="ml-1 text-[11px] text-slate-400">({t.data.closure})</span>}
                  </td>
                  <td>
                    <span class={`text-[11px] px-2 py-0.5 rounded-full whitespace-nowrap ${OWNER_STYLE[t.data.owner] ?? 'bg-rose-50 text-rose-600'}`}>
                      {t.data.owner}
                    </span>
                  </td>
                  <td>
                    <span class={`text-[11px] px-2 py-0.5 rounded-full whitespace-nowrap ${STATUS_STYLE[t.data.status]?.cls ?? ''}`}>
                      {t.data.status}
                    </span>
                  </td>
                  <td class={`text-xs whitespace-nowrap ${PRIORITY_STYLE[t.data.priority] ?? ''}`}>{t.data.priority}</td>
                  <td class="font-mono text-xs text-slate-500 whitespace-nowrap">{t.data.target}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p id="task-empty" class="text-xs text-slate-400 mt-3" hidden>조건에 맞는 일감이 없다</p>
    </section>
  </div>

  <script>
    // 탭은 주소의 #으로 남긴다 — 링크를 건네면 같은 탭이 열린다.
    const tabBar = document.getElementById('task-tabs')!;
    const ownerBar = document.getElementById('owner-filter')!;
    const statusBar = document.getElementById('status-filter')!;
    const rows = [...document.querySelectorAll<HTMLElement>('#task-rows tr')];
    const heads = [...document.querySelectorAll<HTMLElement>('[data-tab-head]')];
    const tabButtons = [...tabBar.querySelectorAll<HTMLElement>('button[data-tab]')];
    const empty = document.getElementById('task-empty')!;

    const picked = (bar: HTMLElement) => bar.querySelector<HTMLElement>('button[data-on="true"]')?.dataset.filter ?? '*';

    function currentTab() {
      const hash = decodeURIComponent(location.hash.slice(1));
      return tabButtons.some((b) => b.dataset.tab === hash) ? hash : tabButtons[0].dataset.tab!;
    }

    function apply() {
      const tab = currentTab();
      const owner = picked(ownerBar);
      const status = picked(statusBar);

      tabButtons.forEach((b) => (b.dataset.on = String(b.dataset.tab === tab)));
      heads.forEach((h) => (h.hidden = h.dataset.tabHead !== tab));

      let visible = 0;
      rows.forEach((r) => {
        const inTab = (r.dataset.tabs ?? '').split(' ').includes(tab);
        r.hidden =
          !inTab || (owner !== '*' && r.dataset.owner !== owner) || (status !== '*' && r.dataset.status !== status);
        visible += r.hidden ? 0 : 1;
      });
      empty.hidden = visible > 0;
    }

    tabBar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('button[data-tab]');
      if (!btn) {
        return;
      }
      history.replaceState(null, '', `#${btn.dataset.tab}`);
      apply();
    });

    // 담당·상태는 하나만 고른다 — 같은 버튼을 다시 누르면 전체로 돌아간다.
    for (const bar of [ownerBar, statusBar]) {
      bar.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('button[data-filter]');
        if (!btn) {
          return;
        }
        const next = btn.dataset.on === 'true' ? '*' : btn.dataset.filter;
        bar.querySelectorAll<HTMLElement>('button[data-filter]').forEach((b) => {
          b.dataset.on = String(b.dataset.filter === next);
        });
        apply();
      });
    }

    // 표 머리 정렬 — 같은 머리를 누를 때마다 오름차순 → 내림차순 → 기본 순서(상태 → 우선순위 → ID).
    const body = document.getElementById('task-rows')!;
    const sortHeads = [...document.querySelectorAll<HTMLElement>('button[data-sort]')];
    const NUMERIC = new Set(['id', 'status', 'priority']);
    let sortKey = '';
    let sortDir = 0; // 1 오름 · -1 내림 · 0 기본

    function valueOf(r: HTMLElement, key: string) {
      return r.dataset[`sort${key[0].toUpperCase()}${key.slice(1)}`] ?? '';
    }

    function applySort() {
      const sorted = [...rows].sort((a, b) => {
        if (sortDir === 0) {
          return Number(a.dataset.rank) - Number(b.dataset.rank);
        }
        const va = valueOf(a, sortKey);
        const vb = valueOf(b, sortKey);
        const cmp = NUMERIC.has(sortKey) ? Number(va) - Number(vb) : va.localeCompare(vb, 'ko');
        // 같은 값끼리는 기본 순서를 지킨다.
        return cmp * sortDir || Number(a.dataset.rank) - Number(b.dataset.rank);
      });
      sorted.forEach((r) => body.appendChild(r));
      sortHeads.forEach((h) => {
        h.dataset.dir = h.dataset.sort === sortKey && sortDir !== 0 ? (sortDir > 0 ? 'asc' : 'desc') : '';
      });
    }

    for (const head of sortHeads) {
      head.addEventListener('click', () => {
        const key = head.dataset.sort!;
        if (key !== sortKey) {
          sortKey = key;
          sortDir = 1;
        } else {
          sortDir = sortDir === 1 ? -1 : sortDir === -1 ? 0 : 1;
        }
        applySort();
      });
    }

    window.addEventListener('hashchange', apply);
    apply();
  </script>
</Layout>
