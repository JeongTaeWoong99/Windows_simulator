---
import Layout from '../../layouts/Layout.astro';
import { loadProposals, ago } from '../../lib/proposals';

const items = loadProposals();
---

<Layout title="기획 (AI)">
  <div class="gn">
    <header class="gn-head">
      <h1>기획 <span class="gn-ai">AI</span></h1>
      <p>
        방치형·Desktop Companion을 게임별로 공부한다. 누가 즐기는지, 왜 재미있는지,
        어떤 요소가 재미와 불편을 만드는지 출처와 함께 읽어 본다.
        <b>게임 연구와 기존 시스템 제안을 함께 모았다.</b> 확정 기획은 게임기획코어에서 확인한다.
      </p>
      <p>정기 조사: 매일 한국시간 06·12·18시 · 회차마다 게임 하나 · PC 실행 환경이 갖춰진 동안 게시</p>
    </header>

    {items.length === 0 && <p class="gn-empty">아직 올라온 연구가 없다.</p>}

    <ol class="gn-list">
      {
        items.map((p) => (
          <li class="gn-row">
            <span class="gn-vote" data-kind={p.verdictKind} title={p.verdict}>▲</span>
            <div class="gn-main">
              <div class="gn-title">
                <a href={`/proposals/${p.slug}`}>{p.kind === 'study' ? `${p.game} — 누가 왜 즐기는가` : p.system}</a>
                {p.kind === 'proposal' && <span class="gn-domain">({p.game})</span>}
              </div>
              {p.summary && <a class="gn-desc" href={`/proposals/${p.slug}`}>{p.summary}</a>}
              <div class="gn-info">
                <span class="gn-badge" data-kind={p.verdictKind}>{p.kind === 'study' ? '게임 연구' : p.verdict}</span>
                {p.cost && <span>코스트 {p.cost}</span>}
                <span>
                  {p.date} {p.hour}시 회차 · {ago(p)}
                </span>
                <span>읽기 {p.readMinutes}분</span>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Layout>
