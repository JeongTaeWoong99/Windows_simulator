---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { STATUS_STYLE } from '../lib/labels';

const tasks = await getCollection('tasks');
const docs = await getCollection('design');

const open = tasks.filter((t) => !t.data.done);
const running = open.filter((t) => t.data.status === '진행중');
const blocked = open.filter((t) => t.data.status === '보류');
const core = docs.find((d) => d.data.slug === 'core');
---

<Layout title="홈">
  <section class="mb-10">
    <h1 class="text-2xl font-extrabold mb-2">Windows_simulator 기획 · 일감</h1>
    <p class="text-slate-500 text-sm">
      저장소의 <code class="text-xs bg-slate-100 px-1 rounded">GameDesign/design</code>과
      <code class="text-xs bg-slate-100 px-1 rounded">tasks</code>를 그대로 읽어 만든다.
      편집은 저장소에서 하고, 여기는 읽기만 한다.
    </p>
  </section>

  <div class="grid gap-4 sm:grid-cols-3 mb-10">
    <a href="/design/core" class="block bg-white border border-slate-200 rounded-lg p-5 hover:border-blue-400">
      <div class="text-xs text-slate-400 mb-1">단일 진입점</div>
      <div class="font-bold">{core?.data.title ?? '게임기획코어'}</div>
      <div class="text-xs text-slate-400 mt-2">최종 업데이트 {core?.data.updated ?? '—'}</div>
    </a>
    <a href="/design" class="block bg-white border border-slate-200 rounded-lg p-5 hover:border-blue-400">
      <div class="text-xs text-slate-400 mb-1">기획 문서</div>
      <div class="font-bold">{docs.length}개</div>
      <div class="text-xs text-slate-400 mt-2">시스템별 상세 기획안</div>
    </a>
    <a href="/tasks" class="block bg-white border border-slate-200 rounded-lg p-5 hover:border-blue-400">
      <div class="text-xs text-slate-400 mb-1">남은 일감</div>
      <div class="font-bold">{open.length}건</div>
      <div class="text-xs text-slate-400 mt-2">진행중 {running.length} · 보류 {blocked.length}</div>
    </a>
  </div>

  {
    running.length > 0 && (
      <section class="mb-10">
        <h2 class="text-sm font-bold text-slate-500 mb-3">지금 진행중</h2>
        <ul class="space-y-2">
          {running.map((t) => (
            <li>
              <a
                href={`/tasks/${t.data.slug}`}
                class="flex items-center gap-3 bg-white border border-slate-200 rounded-lg px-4 py-3 hover:border-blue-400"
              >
                <span class="font-mono text-xs text-slate-400">{t.data.taskId}</span>
                <span class="font-semibold text-sm flex-1">{t.data.title}</span>
                <span class={`text-[11px] px-2 py-0.5 rounded-full ${STATUS_STYLE[t.data.status]?.cls}`}>
                  {t.data.status}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    blocked.length > 0 && (
      <section>
        <h2 class="text-sm font-bold text-slate-500 mb-3">사람이 결정해야 풀리는 것</h2>
        <ul class="space-y-2">
          {blocked.map((t) => (
            <li>
              <a
                href={`/tasks/${t.data.slug}`}
                class="flex items-center gap-3 bg-amber-50 border border-amber-200 rounded-lg px-4 py-3"
              >
                <span class="font-mono text-xs text-amber-600">{t.data.taskId}</span>
                <span class="font-semibold text-sm flex-1">{t.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>
