---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { STATUS_STYLE, OWNER_STYLE, PRIORITY_STYLE, PRIORITY_ORDER, STATUS_ORDER } from '../lib/labels';
import { GITHUB_REPO } from '../lib/paths';

const tasks = await getCollection('tasks');
const docs = await getCollection('design');

const open = tasks.filter((t) => !t.data.done);
const running = open.filter((t) => t.data.status === '진행중');
const blocked = open.filter((t) => t.data.status === '보류');
const core = docs.find((d) => d.data.slug === 'core');

// 일감 보드(/tasks)와 같은 정렬 — 상태 → 우선순위 → ID.
const ranked = [...open].sort(
  (a, b) =>
    (STATUS_ORDER[a.data.status] ?? 9) - (STATUS_ORDER[b.data.status] ?? 9) ||
    (PRIORITY_ORDER[a.data.priority] ?? 9) - (PRIORITY_ORDER[b.data.priority] ?? 9) ||
    a.data.taskId.localeCompare(b.data.taskId),
);

// 담당 값은 클라·서버·공용 셋이다. 공용은 대개 기획 결정이라 홈에서는 "기획"으로 부른다.
const owners = [
  { value: '클라', label: '클라' },
  { value: '서버', label: '서버' },
  { value: '공용', label: '기획' },
].map((o) => ({ ...o, count: open.filter((t) => t.data.owner === o.value).length }));
const ownerLabel = Object.fromEntries(owners.map((o) => [o.value, o.label]));
---

<Layout title="홈">
  <section class="mb-10">
    <h1 class="text-2xl font-extrabold mb-2">Windows_simulator 기획 · 일감</h1>
    <p class="text-slate-500 text-sm">
      저장소의 <code class="text-xs bg-slate-100 px-1 rounded">GameDesign/design</code>과
      <code class="text-xs bg-slate-100 px-1 rounded">tasks</code>를 그대로 읽어 만든다.
      편집은 저장소에서 하고, 여기는 읽기만 한다.
    </p>
  </section>

  <div class="grid gap-4 sm:grid-cols-3 mb-10">
    <a href="/design/core" class="block bg-white border border-slate-200 rounded-lg p-5 hover:border-blue-400">
      <div class="text-xs text-slate-400 mb-1">단일 진입점</div>
      <div class="font-bold">{core?.data.title ?? '게임기획코어'}</div>
      <div class="text-xs text-slate-400 mt-2">최종 업데이트 {core?.data.updated ?? '—'}</div>
    </a>
    <a href="/design" class="block bg-white border border-slate-200 rounded-lg p-5 hover:border-blue-400">
      <div class="text-xs text-slate-400 mb-1">기획 문서</div>
      <div class="font-bold">{docs.length}개</div>
      <div class="text-xs text-slate-400 mt-2">시스템별 상세 기획안</div>
    </a>
    <a href="/tasks" class="block bg-white border border-slate-200 rounded-lg p-5 hover:border-blue-400">
      <div class="text-xs text-slate-400 mb-1">남은 일감</div>
      <div class="font-bold">{open.length}건</div>
      <div class="text-xs text-slate-400 mt-2">진행중 {running.length} · 보류 {blocked.length}</div>
    </a>
  </div>

  <!-- 이슈는 빌드 때가 아니라 방문할 때 불러온다 — 사이트는 문서가 바뀔 때만 다시 빌드되기 때문이다 -->
  <section id="issues" data-repo={GITHUB_REPO} class="mb-10">
    <h2 class="text-sm font-bold text-slate-500 mb-3">
      <a href={`https://github.com/${GITHUB_REPO}/issues`} class="hover:text-blue-600">GitHub 이슈</a>
      <span data-count class="font-normal text-slate-400"></span>
    </h2>
    <p data-message class="text-xs text-slate-400">불러오는 중…</p>
    <ul data-list class="space-y-2"></ul>
  </section>

  <!-- 담당 필터 — 여러 개를 켤 수 있다. 전부 끄면 빈 목록이 된다 -->
  <section class="mb-10">
    <div class="flex flex-wrap items-center gap-1.5 mb-3" id="home-owner-filter">
      <h2 class="text-sm font-bold text-slate-500 mr-2">남은 일감</h2>
      {
        owners.map((o) => (
          <button class="tagbtn" data-filter={o.value} data-on="true">
            {o.label} {o.count}
          </button>
        ))
      }
      <label class="relative ml-auto w-full sm:w-56">
        <svg
          class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-slate-400"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <input
          id="home-task-search"
          type="search"
          placeholder="ID·제목 검색"
          aria-label="일감 검색"
          class="w-full text-sm bg-white border border-slate-200 rounded-full pl-8 pr-3 py-1 focus:outline-none focus:border-blue-400"
        />
      </label>
    </div>
    <ul class="grid gap-2 sm:grid-cols-2" id="home-task-list">
      {
        ranked.map((t) => (
          <li data-owner={t.data.owner} data-search={`${t.data.taskId} ${t.data.title}`.toLowerCase()}>
            <a href={`/tasks/${t.data.slug}`} class="taskcard">
              <div class="flex items-center gap-2 mb-1">
                <span class="font-mono text-[11px] text-slate-400">{t.data.taskId}</span>
                <span class={`text-[10px] px-1.5 py-0.5 rounded-full ${OWNER_STYLE[t.data.owner] ?? ''}`}>
                  {ownerLabel[t.data.owner] ?? t.data.owner}
                </span>
                <span class={`text-[10px] px-1.5 py-0.5 rounded-full ${STATUS_STYLE[t.data.status]?.cls ?? ''}`}>
                  {t.data.status}
                </span>
                <span class={`ml-auto text-[11px] ${PRIORITY_STYLE[t.data.priority] ?? ''}`}>{t.data.priority}</span>
              </div>
              <div class="text-sm font-semibold leading-snug">{t.data.title}</div>
            </a>
          </li>
        ))
      }
    </ul>
    <p id="home-task-empty" class="text-xs text-slate-400" hidden>조건에 맞는 일감이 없다</p>
  </section>

  {
    running.length > 0 && (
      <section class="mb-10">
        <h2 class="text-sm font-bold text-slate-500 mb-3">지금 진행중</h2>
        <ul class="space-y-2">
          {running.map((t) => (
            <li>
              <a
                href={`/tasks/${t.data.slug}`}
                class="flex items-center gap-3 bg-white border border-slate-200 rounded-lg px-4 py-3 hover:border-blue-400"
              >
                <span class="font-mono text-xs text-slate-400">{t.data.taskId}</span>
                <span class="font-semibold text-sm flex-1">{t.data.title}</span>
                <span class={`text-[11px] px-2 py-0.5 rounded-full ${STATUS_STYLE[t.data.status]?.cls}`}>
                  {t.data.status}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    blocked.length > 0 && (
      <section>
        <h2 class="text-sm font-bold text-slate-500 mb-3">사람이 결정해야 풀리는 것</h2>
        <ul class="space-y-2">
          {blocked.map((t) => (
            <li>
              <a
                href={`/tasks/${t.data.slug}`}
                class="flex items-center gap-3 bg-amber-50 border border-amber-200 rounded-lg px-4 py-3"
              >
                <span class="font-mono text-xs text-amber-600">{t.data.taskId}</span>
                <span class="font-semibold text-sm flex-1">{t.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>

<script>
  // 공개 저장소라 토큰 없이 읽는다. 비인증 한도는 IP당 시간당 60회 — 이 사이트 규모엔 충분하다.
  type Issue = {
    number: number;
    title: string;
    html_url: string;
    labels: { name: string }[];
    pull_request?: unknown;
  };

  const root = document.getElementById('issues')!;
  const message = root.querySelector<HTMLElement>('[data-message]')!;
  const list = root.querySelector<HTMLUListElement>('[data-list]')!;
  const count = root.querySelector<HTMLElement>('[data-count]')!;

  async function loadIssues() {
    try {
      const res = await fetch(`https://api.github.com/repos/${root.dataset.repo}/issues?state=open&per_page=100`, {
        headers: { Accept: 'application/vnd.github+json' },
      });
      if (!res.ok) {
        message.textContent = `이슈를 불러오지 못했다 (${res.status})`;
        return;
      }

      // 이 API는 PR도 이슈로 돌려준다. pull_request 필드가 있으면 PR이다.
      const issues = ((await res.json()) as Issue[]).filter((i) => !i.pull_request);
      count.textContent = ` ${issues.length}건`;
      if (issues.length === 0) {
        message.textContent = '열린 이슈가 없다';
        return;
      }

      message.remove();
      for (const issue of issues) {
        list.append(renderIssue(issue));
      }
    } catch {
      message.textContent = '이슈를 불러오지 못했다 (네트워크)';
    }
  }

  // 제목·라벨은 사용자 입력이라 innerHTML을 쓰지 않고 textContent로만 넣는다.
  function renderIssue(issue: Issue) {
    const li = document.createElement('li');
    const a = document.createElement('a');
    a.href = issue.html_url;
    a.className =
      'flex items-center gap-3 bg-white border border-slate-200 rounded-lg px-4 py-3 hover:border-blue-400';

    const num = document.createElement('span');
    num.className = 'font-mono text-xs text-slate-400';
    num.textContent = `#${issue.number}`;

    const title = document.createElement('span');
    title.className = 'font-semibold text-sm flex-1';
    title.textContent = issue.title;

    a.append(num, title);
    for (const label of issue.labels) {
      const tag = document.createElement('span');
      tag.className = 'text-[11px] px-2 py-0.5 rounded-full bg-slate-100 text-slate-600';
      tag.textContent = label.name;
      a.append(tag);
    }

    li.append(a);
    return li;
  }

  loadIssues();

  // 담당 필터 — 버튼마다 따로 켜고 끈다(복수 선택). 검색어와 AND로 걸린다.
  const ownerBar = document.getElementById('home-owner-filter')!;
  const search = document.getElementById('home-task-search') as HTMLInputElement;
  const taskItems = document.querySelectorAll<HTMLElement>('#home-task-list [data-owner]');
  const taskEmpty = document.getElementById('home-task-empty')!;

  function applyTaskFilter() {
    const picked = new Set(
      [...ownerBar.querySelectorAll<HTMLElement>('button[data-on="true"]')].map((b) => b.dataset.filter),
    );
    // 띄어 쓴 낱말이 모두 들어 있어야 걸린다 — "t-06 뽑기"처럼 ID와 제목을 섞어 찾을 수 있게.
    const words = search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);

    let visible = 0;
    taskItems.forEach((el) => {
      const text = el.dataset.search ?? '';
      el.hidden = !picked.has(el.dataset.owner) || !words.every((w) => text.includes(w));
      visible += el.hidden ? 0 : 1;
    });
    taskEmpty.hidden = visible > 0;
  }

  ownerBar.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) {
      return;
    }

    btn.dataset.on = String(btn.dataset.on !== 'true');
    applyTaskFilter();
  });
  search.addEventListener('input', applyTaskFilter);
</script>
